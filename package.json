{
  "name": "hayato-pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "hayato の道具箱。pi coding agent の拡張機能を、hayato が提案し、人がマージして育てる",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typebox": "^1.1.24",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
